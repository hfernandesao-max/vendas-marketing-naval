# Análise estática do back-end PHP (PHPStan). Local: composer install && composer analisar
parameters:
    level: 5
    phpVersion: 70100
    paths:
        - nucleo
        - api
        - geo/senha.php
        - reports/index.php
        - geo/auth
        - geo/login.php
        - ferramentas
        - index.php
    bootstrapFiles:
        - nucleo/arranque.php
