Options -Indexes
DirectoryIndex index.php

# O painel é servido pelo controlador PHP autenticado; o ficheiro HTML é um
# recurso interno e não pode ser acedido diretamente.
<Files "index.html">
    Require all denied
</Files>

# Módulos JavaScript e estilos:
#  - com versão no endereço (?v=…, posta pelo index.php): o navegador guarda-os um ano sem voltar a perguntar;
#    uma actualização muda a versão dos ficheiros alterados, que se descarregam logo;
#  - sem versão (navegadores antigos, bibliotecas de vendor/): o navegador confirma sempre se mudaram (304).
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=[0-9a-f]{6,}/">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
        <Else>
            Header set Cache-Control "no-cache"
        </Else>
    </FilesMatch>
</IfModule>
