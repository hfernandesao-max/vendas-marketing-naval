{
  "name": "geomobilidade-naval",
  "private": true,
  "description": "Portal RTM e GeoMobilidade Naval (Grupo Naval) — ferramentas de desenvolvimento: testes e normas de código",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=portal",
    "test:php": "playwright test --project=servidor",
    "lint": "eslint reports/js tests playwright.config.js eslint.config.js",
    "format": "prettier --write \"reports/js/**/*.js\" \"reports/css/**/*.css\" \"tests/**/*.js\" playwright.config.js eslint.config.js",
    "format:check": "prettier --check \"reports/js/**/*.js\" \"reports/css/**/*.css\" \"tests/**/*.js\" playwright.config.js eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "eslint": "10.12.0",
    "exceljs": "4.4.0",
    "globals": "16.4.0",
    "prettier": "3.6.2"
  }
}
