# Modelo do .env (copie para .env e preencha; o .env nunca vai para o GitHub nem fica acessível pelo Apache).
# Só nomes de chaves e valores ilustrativos: NUNCA ponha aqui segredos reais.
# Todas as chaves estão descritas em docs/ARQUITECTURA.md («Configuração») e docs/SEGURANCA.md.
# Permissões recomendadas no Windows: leitura só para a conta do serviço do Apache e para os administradores.

# ── Base de dados do Pinguim BO (SQL Server) — o portal só faz SELECT ──
# Recomendado: um utilizador só com a função db_datareader (e VIEW DEFINITION para o dicionário técnico).
# Obrigatórias (sem valores predefinidos no código): DB_HOST e DB_NAME (ou DB_DSN completo)
DB_DRIVER=sqlsrv
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASS=
# Ligação cifrada ao SQL Server (1 = sim, recomendado). DB_CONFIAR_CERTIFICADO=0 exige certificado válido no SQL Server.
# DB_ENCRYPT=1
# DB_CONFIAR_CERTIFICADO=1
# DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# DB_TIMEOUT=5
# DB_DSN=

# ── Exportação REST do Pinguim BO (alternativa, se a base de dados não responder) ──
# Obrigatórias: USERNAME, PASSWORD e PINGUIM_URL (endereços por ordem de tentativa, separados por vírgula)
USERNAME=
PASSWORD=
PINGUIM_URL=https://servidor-pinguim.exemplo:porta/rest/exportdata
# Verificação do certificado HTTPS do Pinguim BO (1 = ligada, recomendado; 0 só para certificado interno sem cadeia válida)
# PINGUIM_VERIFICAR_SSL=1
# Estado dos documentos anulados no Pinguim BO (DOCHEADER.DOCSTATUS_ID), fora das vendas; vários separados por vírgulas
# Documentos anulados: motivo de cancelamento (DOCHEADEREXTRA) e, se o Pinguim BO tiver um, o estado de anulado.
# O 8002 NÃO serve: é o estado de todos os documentos fechados (verificado em 11-11-2026).
# PINGUIM_ESTADO_ANULADO=
# PINGUIM_ANULACAO_EXTRA_ID=26003

# ── Pasta privada, contas, email (Microsoft 365) e portal ──
# DADOS_PRIVADOS=C:\Apache24\dados-privados
# UTILIZADORES_JSON=
# RTM_CLIENTES_JSON=
EMAIL_TENANT_ID=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REMETENTE=
# EMAIL_MODO=graph
# Domínios para onde a plataforma pode enviar (separados por vírgula); vazio = qualquer domínio
# EMAIL_DOMINIOS_PERMITIDOS=naval.co.ao
PORTAL_URL=https://portal.exemplo:porta
# FUSO_HORARIO=Africa/Luanda

# ── GEO: chave de navegador do Google Maps (obrigatória para os mapas) ──
# Restringir na Google Cloud Console: HTTP referrers = endereço do portal; APIs = só Maps JavaScript API.
GOOGLE_MAPS_API_KEY=

# ── API central (tokens de acesso JWT) ──
# Obrigatória: chave de assinatura com pelo menos 32 caracteres aleatórios. Gerar no servidor com:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SEGREDO=
# Durante uma troca de chave: a anterior, só para validar tokens ainda abertos (até 15 min)
# JWT_SEGREDO_ANTERIOR=
# Limites por pessoa e por minuto: pedidos à API e tokens novos
# API_RITMO=300
# API_RITMO_TOKEN=30

# ── Segurança ──
# Entradas falhadas por endereço IP em 15 minutos antes de suspender as entradas desse IP (omissão 20)
# LOGIN_MAX_FALHAS_IP=100
# Atrás de um proxy/balanceador que termina o HTTPS: 1 para confiar em X-Forwarded-Proto (cookie Secure, HSTS)
# PROXY_HTTPS=0
# IP dos proxies inversos de confiança (separados por vírgula): o IP do cliente vem de X-Forwarded-For
# PROXY_CONFIAVEIS=
# Redireccionar todo o HTTP para HTTPS (activar depois de instalado o certificado)
# EXIGIR_HTTPS=0
# Dois passos obrigatórios para os perfis marcados na matriz: a pessoa configura-os na entrada (1 = sim)
# MFA_OBRIGATORIA=1
# Content-Security-Policy completa aplicada (1) em vez de só em relatório (0), depois de verificada a consola
# CSP_APLICAR=0
# Modo de diagnóstico: mostra detalhes técnicos dos erros a todos os perfis. NUNCA ligar em produção.
# APP_DEBUG=0

# ── Comunicação dos smartphones (horas): em dia até ALERTA, atenção até CRITICO, crítico acima ──
# SYNC_ALERTA_HORAS=2
# SYNC_CRITICO_HORAS=24
# Comunicação AGT: campo extra (DOCEXTRA_ID) de DOCHEADEREXTRA com o motivo de cancelamento
# AGT_ANULACAO_ID=26003

# ── Equipamentos (smartphones e impressoras do terreno) ──
# Base de dados própria do módulo, com escrita (tabelas ATV_*: ferramentas/sql/equipamentos-sqlserver.sql). Separada da
# do Pinguim BO, que o portal só lê. Servidor, porta, driver e cifra vêm de DB_* quando não se indicam aqui.
# ATV_DB_NAME=GN_EQUIPAMENTOS
# ATV_DB_HOST=
# ATV_DB_USER=
# ATV_DB_PASS=
# Em alternativa, um DSN PDO completo (os testes usam sqlite:...)
# ATV_DB_DSN=
# Contacto de devolução na página pública do código QR (equipamentos/ficha.php)
# ATV_CONTACTO_DEVOLUCAO_TEL=
# ATV_CONTACTO_DEVOLUCAO_EMAIL=
# Endereço do QR das etiquetas (reencaminha para equipamentos/ficha.php?id=)
# ATV_URL_RESOLVEDOR=https://id.naval.co.ao/a/
# Ligação «Abrir no MDM» da ficha ({id} = ID do equipamento no MDM Plus)
# MDM_URL_EQUIPAMENTO=
# MDM Plus pela API (Self Client da Zoho, centro de dados .com). Fase 1: só leitura, para verificar a ligação e
# cruzar os equipamentos (php ferramentas/verificar-mdm.php); as ordens ao MDM são da fase 2.
# MDM_API_BASE=https://mdm.manageengine.com
# MDM_ACCOUNTS_BASE=https://accounts.zoho.com
# MDM_OAUTH_CLIENT_ID=
# MDM_OAUTH_CLIENT_SECRET=
# MDM_OAUTH_REFRESH_TOKEN=
# Fase 2 (ainda não usada): selagem PAdES do PDF assinado
# PADES_CERT_PATH=
# PADES_CERT_PASSWORD=

# ── Actualizações automáticas (ferramentas/actualizar.php; tarefa agendada «Portal RTM - Actualizacao») ──
# Token «fine-grained» do GitHub só com «Contents: Read-only» no repositório do portal. Gravado pelo comando
# «php ferramentas/actualizar.php configurar» (nunca escrever à mão nem enviar por correio ou conversa).
# Recomendado em vez do código pessoal: GitHub App («Contents: Read-only», instalada só no repositório do portal); a
# chave privada fica na pasta privada (actualizacoes/github-app.pem) e não expira. Gravado por «configurar».
# ACTUALIZACAO_GITHUB_APP_ID=
# ACTUALIZACAO_GITHUB_APP_INSTALACAO=   (vazio = descoberta sozinha)
# ACTUALIZACAO_GITHUB_APP_CHAVE=        (vazio = <DADOS_PRIVADOS>/actualizacoes/github-app.pem)
# ACTUALIZACAO_GITHUB_TOKEN=
# 1 = a tarefa agendada aplica as versões novas; 0 = pausa (os comandos manuais continuam a funcionar)
# ACTUALIZACAO_AUTOMATICA=1
# Ambiente de ensaio dentro do portal (<portal>/ensaio, só SADM e TI): cada versão nova instala-se lá primeiro, com
# testes de fumo, e só se aprova depois de passar (0 = sem ensaio e sem essa exigência)
# ENSAIO=1
# 1 = só instala versões aprovadas no portal (Administração › Actualizações); 0 = instala todas as publicadas
# ACTUALIZACAO_EXIGE_APROVACAO=1
# Versões não decididas durante o dia: aprovadas sozinhas às 02:45 («0» desliga) e instaladas às 03:00
# ACTUALIZACAO_APROVACAO_AUTOMATICA=02:45
# ACTUALIZACAO_INSTALACAO_NOCTURNA=03:00
# Minutos mínimos desde a publicação para a aprovação automática (as mais novas ficam para a noite seguinte)
# ACTUALIZACAO_APROVACAO_IDADE_MIN=60
# Correio para os avisos (aplicada, parada por alterações à mão, revertida, token a expirar); vários separados por vírgula
# ACTUALIZACAO_EMAIL=
# Endereço usado nas verificações depois de actualizar (omissão PORTAL_URL); ex.: https://localhost:2051
# ACTUALIZACAO_URL_VERIFICACAO=
# Serviço do Apache a reiniciar se o php.ini tiver opcache.validate_timestamps=0 (ex.: Apache2.4);
# ACTUALIZACAO_REINICIAR_APACHE=1 reinicia-o sempre depois de copiar
# ACTUALIZACAO_APACHE_SERVICO=
# Apache e PHP geridos pelo actualizador (configuração em ferramentas/apache/portal-rtm.conf; requisitos em
# ferramentas/requisitos.json): httpd.exe, httpd.conf e php.ini usados pelo Apache
# ACTUALIZACAO_APACHE_BIN=C:/Apache24/bin/httpd.exe
# ACTUALIZACAO_APACHE_CONF=C:/Apache24/conf/httpd.conf
# ACTUALIZACAO_PHP_INI=
# Certificados HTTPS vigiados além de PORTAL_URL e ATV_URL_RESOLVEDOR (anfitrião[:porta], separados por vírgula)
# ACTUALIZACAO_CERTIFICADOS=
# ACTUALIZACAO_REINICIAR_APACHE=0
# Conta da base de dados do módulo Equipamentos com permissão para alterar tabelas (db_ddladmin), só para as
# migrações (ferramentas/sql/migracoes); sem ela usa ATV_DB_USER
# ATV_DB_MIGRACAO_USER=
# ATV_DB_MIGRACAO_PASS=

# ── Gestão com IA (alertas, previsão, assistente, resumo diário) ──
# Chave da API da Anthropic (conta comercial da empresa): gravada por «php ferramentas/configurar-ia.php», nunca à mão
# IA_API_KEY=
# IA_MODELO=claude-sonnet-5-5
# Limites: tokens por mês (todas as pessoas) e perguntas por pessoa e por dia
# IA_LIMITE_TOKENS_MES=5000000
# IA_PERGUNTAS_DIA=60
# 0 = desliga o assistente sem apagar a chave
# IA_ACTIVA=1
# Resumo diário por correio (perfis com «Resumo diário» na matriz de acessos)
# RESUMO_ACTIVO=1
# RESUMO_HORA=07:00
# 0 = resumo sem o parágrafo escrito pela IA
# RESUMO_IA=1
# 0 = o plano de cargas volta a sugerir só as quantidades da última carga
# PREVISAO_PLANO=1
# Afinação dos alertas (omissões entre parênteses): semanas de histórico (6), queda do dia (0.5), queda da semana
# (0.25), subida da semana (0.4), dias sem compras de um cliente regular (30), dias por comunicar à AGT (2), dias sem
# contacto com o MDM (2)
# ALERTAS_SEMANAS= ALERTAS_QUEDA_DIA= ALERTAS_QUEDA_SEMANA= ALERTAS_SUBIDA_SEMANA= ALERTAS_CLIENTE_DIAS= ALERTAS_AGT_DIAS= ALERTAS_MDM_DIAS=
# Endereço curto impresso nos cartazes QR dos clientes (omissão: PORTAL_URL/c/?k=…); ex.: https://id.naval.co.ao
# QR_URL_CURTO=

# ── Conciliação da carrinha (Logística) ──
# Contagem cega no regresso (o técnico não vê o esperado antes de gravar): 1 = sim (recomendado), 0 = não
# CARRINHA_CONTAGEM_CEGA=1
# Falta aprovada a partir da qual a Direcção e o Financeiro recebem aviso por correio electrónico (Kz; 0 = nunca)
# CARRINHA_LIMITE_KZ=50000
# Aviso do fim do dia a quem conta e aprova, com as carrinhas por contar ou por aprovar (0 = desligado)
# CARRINHA_AVISO_ACTIVO=1
# CARRINHA_HORA_AVISO=19:30
# Fecho de rota por excepção: contagem igual ao esperado em todos os artigos e sem alertas fecha sozinha (0 = aprovar sempre)
# CARRINHA_FECHO_AUTOMATICO=1
# Ligações preparadas no Painel da carrinha (o bloco passa a «Ligado» quando a chave existe)
# PINGUIM_CONTAGENS_TABELA=           (tabela das contagens da solução de contagem do Pinguim BO, só leitura)
# QUATENUS_API_URL=                   (API da Quatenus: percurso, paragens e aberturas de porta)
# CCTV_NVR_URL=                       (gravador NVR do CCTV do parque: imagens da carga e da descarga)

# ── GeoMobilidade: prospecção e territórios das rotas ──
# 0 = desligado (o cálculo corre de madrugada, a partir de GEO_HORA_INICIO, pela tarefa de 5 em 5 minutos)
# GEO_ACTIVO=1
# GEO_HORA_INICIO=01:00
# Capacidade de cada rota (vendedor + viatura): visitas por dia × dias de trabalho por semana
# GEO_VISITAS_DIA=30
# GEO_DIAS_SEMANA=6
# Ocupação a partir da qual a rota conta como cheia (14 dias seguidos = aviso de nova rota)
# GEO_LIMIAR_ROTA=0.9
# Distância máxima (m) de um potencial cliente aos clientes da rota para entrar no território
# GEO_RAIO_TERRITORIO=1500
# Potenciais clientes numa zona sem rota (~2 km) a partir dos quais se sugere uma rota nova
# GEO_MIN_ZONA_NOVA=40
# OpenStreetMap (gratuito, uma vez por semana): 0 = desligado
# GEO_OSM_ACTIVO=1
# GEO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Google Places (API New): chave de SERVIDOR própria, restringida na Google Cloud Console à «Places API (New)»
# e ao endereço IP do servidor (não usar a chave do mapa do navegador). Sem chave, só o OpenStreetMap.
# GOOGLE_PLACES_API_KEY=
# Limite de pedidos por mês (os primeiros 5000 do mês são gratuitos) e dias que as coordenadas do Google podem
# ficar guardadas (regras do Google: no máximo 30)
# GEO_GOOGLE_PEDIDOS_MES=4500
# GEO_GOOGLE_DIAS=30

# ── Servidor OLAP (localização da aplicação de vendas e do registo de clientes) — só leitura ──
# Como as outras bases de dados: OLAP_HOST, OLAP_PORT, OLAP_NAME, OLAP_USER, OLAP_PASS (ou OLAP_DSN).
# A consulta vem de ferramentas/sql/olap-localizacao.sql (ver o .exemplo.sql) ou da vista OLAP_VISTA, com as colunas
# DATA_HORA, ROTA, LATITUDE, LONGITUDE e, facultativas, DOCUMENTO, CLIENTE, PRECISAO (m) e TIPO.
# OLAP_HOST=
# OLAP_NAME=
# OLAP_USER=
# OLAP_PASS=
# OLAP_VISTA=dbo.vw_localizacao
# Precisão máxima aceite (m) e distância máxima de uma venda às coordenadas do cliente (prova de visita, m)
# OLAP_PRECISAO_MAX=100
# OLAP_RAIO_VISITA=150

# ── Rotina diária automática ──
# Plano de cargas de amanhã proposto (rascunho para a Logística confirmar) e fecho do dia por rota por correio
# PLANO_PROPOSTA_ACTIVA=1
# PLANO_HORA_PROPOSTA=18:00
# FECHO_ACTIVO=1
# FECHO_HORA=20:00

# ── Optimização automática das rotas (todas as noites, depois da carteira) ──
# Ponto de partida das carrinhas (lat,lng): para todas as rotas e/ou por rota. Sem isto, usa o sítio onde a carrinha
# costuma começar o dia (servidor OLAP) ou, sem localização, começa no primeiro cliente.
# ROTAS_PARTIDA=-8.8383,13.2344
# ROTAS_PARTIDA_1001=-8.8383,13.2344
# ROTAS_HORA_INICIO=08:00
# ROTAS_VELOCIDADE_KMH=20
# ROTAS_TEMPO_CLIENTE_MIN=12
# ROTAS_FACTOR_ESTRADA=1.35
# ROTAS_JORNADA_H=9
# ROTAS_REGRESSO=1

# ── Comunicação AGT ──
# Campo extra com a resposta da AGT (INTEGER_VALUE: 3 Enviado, 5 Erro, 2 Pendente; STRING_VALUE: texto da resposta)
# AGT_ESTADO_ID=26098
# Textos da AGT que confirmam o envio, separados por |
# AGT_SUCESSO_TEXTOS=Process completed successfully|já consta no repositório

# Localização dos IP nos registos de actividade (país e cidade de cada entrada): base de dados DB-IP «IP to City Lite»,
# instalada e renovada todos os meses pela tarefa automática do portal (de madrugada). 0 desliga.
GEOIP_AUTOMATICO=1
# GEOIP_BD=C:\caminho\cidades.mmdb   (omissão: dados-privados/geoip/cidades.mmdb)

# GPS da frota (Quatenus): endereço da API e credenciais de um utilizador técnico só de leitura, pedidos à Quatenus Angola.
# Enquanto vazio, a integração aparece como «Por ligar» na Apresentação do portal.
QUATENUS_API_URL=
QUATENUS_API_UTILIZADOR=
QUATENUS_API_SENHA=

# CCTV do parque da Foodtec: endereço do gravador (NVR) ou da câmara de leitura de matrículas que envia os eventos de
# entrada e saída das viaturas. Só eventos (matrícula, hora, sentido); o vídeo fica no gravador.
CCTV_API_URL=
CCTV_API_UTILIZADOR=
CCTV_API_SENHA=

# ── Conformidade (ISO/IEC 27001, 27701, ISO 22301): rotina diária automática, ver docs/CONFORMIDADE.md ──
# CONFORMIDADE_HORA=02:00
# Chave das cópias diárias dos dados privados (AES-256-GCM); sem ela, as cópias ficam sem cifra (aviso na página)
# COPIAS_CHAVE=
# COPIAS_DIAS=14
# Pasta fora do servidor (rede ou disco externo) para as cópias e para os registos de auditoria
# COPIAS_PASTA_EXTERNA=
# REGISTOS_COPIA_PASTA=
# Contas sem entrada há mais destes dias desligam-se sozinhas (nunca o super administrador)
# CONTAS_DIAS_SEM_USO=90
# Prazos de retenção em dias (o que passa do prazo é apagado todas as noites)
# RETENCAO_REGISTOS_DIAS=1095
# RETENCAO_DESEMPENHO_DIAS=180
# RETENCAO_CARRINHA_DIAS=1825
# RETENCAO_EMAIL_DIAS=90
# RETENCAO_RECUPERACAO_DIAS=30
# RETENCAO_TENTATIVAS_DIAS=90
# RETENCAO_OPERACAO_DIAS=90
# RETENCAO_RESUMO_DIAS=365
# RETENCAO_CONFORMIDADE_DIAS=1095
# RETENCAO_SUPORTE_DIAS=1095
