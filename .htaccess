Options -Indexes
DirectoryIndex index.php
ServerSignature Off

# A interface do hub é servida pelo controlador PHP autenticado.
<Files "index.html">
    Require all denied
</Files>

# ── Ficheiros que nunca podem ser servidos pelo Apache ──────────────────────────────────────
# Configuração e segredos (.env, .env.*, .git, .htaccess e outros ficheiros começados por ponto)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# Dados (CSV, folhas de cálculo, bases de dados), cópias de segurança, registos e configurações
<FilesMatch "(?i)\.(csv|tsv|xlsx?|sql|sqlite|db|bak|backup|old|orig|save|swp|tmp|log|jsonl|ini|conf|cfg|dist|neon|lock|sh|ps1|bat|py)$|~$">
    Require all denied
</FilesMatch>
# Chaves, certificados e arquivos comprimidos (ex.: a chave .pem da GitHub App ou um .zip deixados na pasta do site)
<FilesMatch "(?i)\.(pem|key|crt|cer|der|csr|pfx|p12|jks|kdbx|ppk|zip|rar|7z|gz|tgz|tar|bz2|xz|cab|iso|msi|exe|dll|bk|dump|xml|md)$">
    Require all denied
</FilesMatch>
# Notas e listas em texto (ex.: «APP ID.txt»), excepto robots.txt, security.txt e as licenças das fontes e bibliotecas
<FilesMatch "(?i)^(?!(robots|security|humans)\.txt$|licen[cs][ae]|ofl-).*\.txt$">
    Require all denied
</FilesMatch>
# Documentação e configurações do projecto na raiz (não são páginas do portal)
<FilesMatch "^(composer\.json|package(-lock)?\.json|README\.md|CHANGELOG\.md|CONTRIBUTING\.md|eslint\.config\.js|playwright\.config\.js|phpstan\.neon\.dist)$">
    Require all denied
</FilesMatch>

# Pastas internas (código do núcleo, ferramentas, testes, documentação, dependências) e pastas
# começadas por ponto (.git, .github): <If> é do núcleo do Apache 2.4, não precisa de mod_rewrite.
<If "%{REQUEST_URI} =~ m#/\.(?!well-known/)# || %{REQUEST_URI} =~ m#/(nucleo|ferramentas|tests|docs|node_modules|test-results|playwright-report|scripts|dados-privados)(/|$)#">
    Require all denied
</If>

# ── Cabeçalhos de segurança (também enviados pelo PHP nas páginas e serviços) ───────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), geolocation=(self)"
    Header always unset X-Powered-By
    # HSTS só quando o site estiver em HTTPS (o navegador ignora-o em HTTP)
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# ── App instalável (PWA «Equipamentos») ─────────────────────────────────────────────────────
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    # O service worker e o manifesto nunca ficam em cache no navegador: as actualizações chegam logo
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ── Velocidade ──────────────────────────────────────────────────────────────────────────────────
# Compressão do texto (HTML, CSS, JS, SVG): cerca de 3 vezes menos bytes nas redes móveis. As respostas da
# API são comprimidas pelo próprio PHP (com ETag e 304), por isso o JSON fica fora desta regra.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/manifest+json image/svg+xml
</IfModule>
# Letras do portal (assets/fontes): nomes fixos por versão, guardadas um ano no navegador
<IfModule mod_headers.c>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
AddType font/woff2 .woff2

