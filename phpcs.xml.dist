<?xml version="1.0"?>
<!--
  Verificação de compatibilidade do PHP: o código tem de correr no PHP do servidor de produção
  (Apache em Windows). Versão mínima suportada: 7.1.
-->
<ruleset name="Portal RTM">
    <description>Compatibilidade do back-end com PHP 7.1 ou posterior.</description>
    <file>nucleo</file>
    <file>reports</file>
    <file>geo</file>
    <file>ferramentas</file>
    <file>index.php</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*.js</exclude-pattern>
    <exclude-pattern>*.css</exclude-pattern>
    <exclude-pattern>*.html</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <config name="testVersion" value="7.1-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
